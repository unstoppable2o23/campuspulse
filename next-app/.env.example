# Local dev — point at your Postgres (Supabase project URL works: use the
# connection-string from Supabase Dashboard → Project Settings → Database).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campuspulse"

# 32+ random bytes. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-in-production"

NEXT_PUBLIC_APP_NAME="CampusPulse"
